      m_Items: []
  - m_Id: 83464764109856768
    m_Localized: actually, uhm this makes you slow but it gives more damage
    m_Metadata:
      m_Items: []
  - m_Id: 83464802022170624
    m_Localized: This makes you fat, meaning you will move slow but at least you
      get more health, RIGHT?!
