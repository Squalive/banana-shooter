  - m_Id: 83104177924317184
    m_Localized: Magaling, Rebel, Galingan mo lang
    m_Metadata:
      m_Items: []
  - m_Id: 83104216520302592
    m_Localized: Maganda itong laban, Ikaw ang kailangan namin
    m_Metadata:
      m_Items: []
  - m_Id: 83104404752277504
    m_Localized: Wag kang malungkot, Ang masama ay laging matatalo
