  - m_Id: 83380486009233408
    m_Localized: "\u0411\u0435\u0433 \u043F\u043E \u0441\u0442\u0435\u043D\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 83104177924317184
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u041F\u043E\u0432\u0441\u0442\u0430\u043D\u0446\u044B, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u0432 \u0442\u043E\u043C \u0436\u0435 \u0434\u0443\u0445\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 83104216520302592
    m_Localized: "\u042D\u0442\u043E \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0431\u043E\u0439, \u0442\u044B \u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u043C \u043D\u0443\u0436\u0435\u043D "
    m_Metadata:
      m_Items: []
  - m_Id: 83104413484818432
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0435\u043B\u0430\u0435\u0448\u044C?
      \u042D\u0442\u043E \u0442\u0432\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0442\u0435\u0431\u044F \u043C\u043E\u0433\u0443\u0442 \u0443\u0432\u043E\u043B\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 83104404752277504
    m_Localized: "\u041D\u0435 \u043E\u0442\u0447\u0430\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C,
      \u0437\u043B\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 83464252526403584
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u044D\u0442\u043E\u0442
      \u043F\u0435\u0440\u043A \u0434\u043B\u044F \u0431\u0435\u0433\u0430 \u043F\u043E
      \u0441\u0442\u0435\u043D\u0430\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 83464648506449920
    m_Localized: "\u0421\u0430\u043C\u044B\u0435 \u0411\u044B\u0441\u0442\u0440\u044B\u0435
      \u0440\u0443\u043A\u0438 \u043D\u0430 \u0414\u0438\u043A\u043E\u043C \u0417\u0430\u043F\u0430\u0434\u0435!
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u044D\u0442\u043E\u0442
      \u041F\u0435\u0440\u043A \u0447\u0442\u043E\u0431\u044B \u041F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0440\u0430\u0437\u044B \u0411\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 83464695826587648
    m_Localized: "\u0414\u0435\u043B\u0430\u0439 \u0432\u0438\u0434, \u0447\u0442\u043E
      \u0442\u044B \u043B\u044F\u0433\u0443\u0448\u043A\u0430 ,\u0438 \u044D\u0442\u043E
      \u0434\u0430\u0441\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043F\u0440\u044B\u0433\u0430\u0442\u044C \u0432\u044B\u0448\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 83464729955639296
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0434\u043B\u044F
