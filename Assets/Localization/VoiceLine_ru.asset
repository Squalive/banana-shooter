  m_TableData:
  - m_Id: 106681065472
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442 \u0414\u044D\u0439\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 167204872192
    m_Localized: "\u041A\u043E\u043C\u0430\u043D\u0434\u043D\u0430\u044F \u0411\u043E\u0439\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 473217097728
    m_Localized: "\u0411\u043E\u0439\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 648295735296
    m_Localized: "\u0423\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F, \u0442\u0435
      \u0447\u0442\u043E \u0441 \u0441\u0438\u043D\u0438\u043C \u043D\u0438\u043A\u043D\u0435\u0439\u043C\u043E\u043C
      - \u0434\u0440\u0443\u0437\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 818114715648
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0439\u0441\u044F \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
      \u0440\u0430\u0434\u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E
      \u0431\u0430\u043D\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1095303684096
    m_Localized: "\u043E\u0448\u0438\u0431\u043A\u0430, \u044D\u0442\u0430 \u043E\u0437\u0432\u0443\u0447\u043A\u0430
      \u043D\u0435 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1273158950912
    m_Localized: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0441\u044F
      \u0434\u043B\u044F \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043C\u0430\u0442\u0447\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438368391168
    m_Localized: "\u042D\u0442\u043E\u0442 \u041C\u0430\u0442\u0447 \u0411\u044B\u043B
      \u041A\u043B\u0430\u0441\u0441\u043D\u044B\u043C, \u041D\u043E \u0442\u044B
      \u043D\u0435 \u0440\u0430\u0441\u0441\u043B\u043E\u0431\u043B\u044F\u0439\u0441\u044F,
      \u0433\u043E\u0442\u043E\u0432\u0441\u044F, \u0438\u043D\u0430\u0447\u0435
      \u044F \u0442\u0435\u0431\u044F \u0448\u043B\u0451\u043F\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1616655671296
    m_Localized: "\u041E\u0445 \u0442\u044B \u0440\u0435\u0430\u043B\u044C\u043D\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u0433\u0440\u0430\u0435\u0448\u044C
      \u043F\u043B\u043E\u0445\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1781269520384
    m_Localized: "\u041D\u043E \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F,
      \u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0441\u044F \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u041C\u0430\u0442\u0447\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2058659815424
    m_Localized: "\u0412\u0430\u0443, \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u041A\u043E\u0440\u043E\u0431\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 2173210451968
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u0441\u0442\u043E\u0438\u0442
      \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0435\u0433\u043E \u0432 \u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2396678774784
    m_Localized: "\u042D\u0442\u043E\u0442 \u0427\u0443\u0432\u0430\u043A \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u043B \u041F\u043E\u043C\u0435\u0440\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2671837700096
    m_Localized: "\u0422\u0443\u0442 \u043C\u043D\u043E\u0433\u043E \u043A\u043E\u0433\u043E
      \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u0438\u0431\u0438\u0442\u044C,
      \u0437\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u043C\u0435\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2828276850688
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B\u0442\u044C \u0447\u0435\u0441\u0442\u043D\u044B\u043C,
      \u0442\u043E \u0442\u043E\u0442 \u0447\u0435\u043B \u043D\u0438\u0447\u0435\u0433\u043E
      \u043F\u043B\u043E\u0445\u043E\u0433\u043E \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 2923642740736
    m_Localized: "\u043D\u043E \u0437\u0430 \u0442\u043E \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B
      \u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3044728102912
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0443\u043C\u0438\u0440\u0435\u0442\u044C,"
    m_Metadata:
      m_Items: []
  - m_Id: 3162722263040
    m_Localized: "\u0417\u0430 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u043C\u0435\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3329458429952
    m_Localized: "\u041E\u0445, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0442\u0435\u0431\u0435
      \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0433\u0440\u0443\u0441\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 3432571199488
    m_Localized: "\u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0423\u0441\u0432\u043E\u0438\u043B
      \u041D\u0430\u0432\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 3530898268160
    m_Localized: "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u0442\u0430\u043A
      \u0411\u043B\u0438\u0437\u043A\u043E, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435
      \u0442\u044B \u0437\u043B\u0438\u0448\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3652554055680
    m_Localized: "\u0425\u0435-\u0445\u0435, \u044F \u0437\u043D\u0430\u043B \u043A\u0430\u043A
      \u0442\u044B \u043F\u043E\u043C\u0440\u0451\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3755939454976
    m_Localized: "\u041E \u0434\u0430, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u0421\u0440\u0430\u0436\u0430\u0442\u0441\u044F \u0434\u0440\u0443\u0433 \u0441
      \u0414\u0440\u0443\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 4200581816320
    m_Localized: "\u043D\u0435\u0442 \u0443\u0431\u0438\u0439\u0441\u0442\u0432,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u0435\u0440\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4301907812352
    m_Localized: "\u041D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
      \u043C\u043D\u043E\u0433\u043E \u0443\u0431\u0438\u0432\u0430\u0442\u044C,
      \u043C\u0430\u043B\u044C\u0447\u0438\u043A \u043C\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 4411387535360
    m_Localized: "\u041D\u043D\u043D\u0435\u0435\u0415\u0415\u0435\u0422!"
    m_Metadata:
      m_Items: []
  - m_Id: 4533672468480
    m_Localized: "\u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0448\u044C
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435, \u0430 \u044F \u043F\u043E\u043B\u0443\u0447\u0430\u044E
      \u0442\u0448\u044B\u0436\u043F\u0430\u0448\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 5186444582912
    m_Localized: "\u0425\u0435-\u0445\u0435, \u043A\u043B\u0451\u0432\u043E\u0435
      \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5465114140672
    m_Localized: "\u0425\u0410\u0425\u0410\u0445\u0430\u0445\u0410\u0445\u0410\u0425"
    m_Metadata:
      m_Items: []
  - m_Id: 5744970686464
    m_Localized: "\u042F \u043D\u0435 \u041F\u0441\u0438\u0445, \u044D\u0442\u043E
      \u0442\u044B \u0442\u0443\u0442 \u043F\u0441\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 5838470111232
    m_Localized: "\u043F\u0444\u043B\u0449\u0445\u043F\u044D\u0444\u043E\u043F\u043E\u0449\u044B\u0444\u0433\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 6027616444416
    m_Localized: "\u0434\u043E\u0431\u0430\u0432\u044C karlson \u0432 \u0432 \u0441\u043F\u0438\u0441\u043E\u043A
      \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0433\u043E \u0432 Steam \u0421\u0415\u0419\u0427\u0410\u0421
      \u0416\u0415!"
    m_Metadata:
      m_Items: []
  - m_Id: 6123410153472
    m_Localized: "\u0411\u0430\u043D\u0430\u043D\u044B \u0431\u0430\u043D\u0430\u043D\u044B
      \u0431\u0430\u043D\u0430\u043D\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 6247272144896
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C, \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C
      \u0438 \u0431\u0430\u043D\u0430\u043D\u043E\u0432\u044B\u0439 \u0443\u0436\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6331191779328
    m_Localized: "\u0422\u0432\u043E\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E, \u043D\u043E \u043D\u0435
      \u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6468290994176
    m_Localized: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0442\u044B
      \u0432\u044B\u0438\u0433\u0440\u0430\u043B \u043D\u043E \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
      \u0434\u0435\u043B\u0435 - \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6683311988736
    m_Localized: " \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439
      \u0442\u044B \u0442\u0430\u043A, \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C \u0431\u0430\u043D\u0430\u043D
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6767286149120
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0435\u0435, \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u041E\u043E\u043E\u041E \u0414\u0430\u0430\u0410\u0410\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6853156134912
    m_Localized: "\u0427\u0435\u0433\u043E \u0442\u044B \u0436\u0434\u0451\u0448\u044C?
      \u0425\u0432\u0430\u0442\u0438\u0442 \u0421\u0442\u043E\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 26170121739804672
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 26170119336468480
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435, \u0432\u044B
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0435
      \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 26170116895383552
    m_Localized: "\u0423 \u0432\u0440\u0430\u0433\u0430 \u0431\u0443\u0434\u0435\u0442
      \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430 \u043D\u0430
      \u0433\u043E\u043B\u043E\u0432\u0435, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0441\u0432\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0432 \u043D\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 26059275952955392
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E, \u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u0434\u0430\u0440 \u0440\u0435\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 26058899291873280
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044C,
      \u0432\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u0432 \u0437\u043E\u043D\u0443
      \u043B\u0438\u043D\u0438\u0438, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C
      \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 26058916425605120
    m_Localized: "\u041E, \u0442\u044B \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0448\u044C\u0441\u044F
      \u0432 \u044D\u0442\u043E\u0442 \u0438\u0433\u0440\u043E\u0432\u043E\u0439
      \u0440\u0435\u0436\u0438\u043C, \u0445\u0430, \u0442\u0430\u043A \u0432\u0435\u0441\u0435\u043B\u043E,
      \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B,
      \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0441\u043D\u043E\u0432\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0438\u0433\u0440\u0430\u0442\u044C \u0432
      \u044D\u0442\u043E\u0442 \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u0440\u0435\u0436\u0438\u043C
      \u0434\u0432\u0430\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 26058950479159296
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435, \u0432\u044B
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441\u043D\u043E\u0432\u0430? \u0432 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435
      \u0432\u0441\u0442\u0430\u043D\u044C\u0442\u0435 \u0432 \u0437\u043E\u043D\u0443
      \u0431\u0435\u043B\u043E\u0439 \u043B\u0438\u043D\u0438\u0438, \u0442\u043E\u0433\u0434\u0430
      \u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044E \u043C\u043E\u0435\u043C\u0443
      \u0431\u0443\u0430\u0441\u0443 \u0434\u0440\u0430\u0442\u044C\u0441\u044F \u0441
      \u0432\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 26058974747402240
    m_Localized: "\u0425\u0430, \u0442\u044B \u043A\u0430\u0436\u0435\u0448\u044C\u0441\u044F
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C \u0431\u0430\u043D\u0430\u043D\u043E\u0432\u044B\u043C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u0442\u0430\u043A
      \u043A\u0430\u043A \u0442\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0448\u044C
      \u044D\u0442\u043E\u0442 \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u0440\u0435\u0436\u0438\u043C
      \u0432 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044B\u0439 \u0440\u0430\u0437,
      \u0434\u0430\u0432\u0430\u0439, \u0434\u0430\u0432\u0430\u0439 \u043D\u0430\u0447\u043D\u0435\u043C
      \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 26058975758229504
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u0432 \u0437\u043E\u043D\u0443
      \u0431\u0435\u043B\u043E\u0439 \u043B\u0438\u043D\u0438\u0438 , \u0412\u0441\u0442\u0430\u0442\u044C
      \u0432 \u0437\u043E\u043D\u0443 \u0431\u0435\u043B\u043E\u0439 \u043B\u0438\u043D\u0438\u0438
      , \u0412\u0441\u0442\u0430\u0442\u044C \u0432 \u0437\u043E\u043D\u0443 \u0431\u0435\u043B\u043E\u0439
      \u043B\u0438\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 26059075721076736
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u044D\u0442\u043E, \u0432\u0441\u0435\u0433\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0440\u043E\u0431\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 26059087435767808
    m_Localized: "\u0414\u0430 \u043B\u0430\u0434\u043D\u043E, \u0437\u0434\u0435\u0441\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u043E\u0431\u043E\u0442\u043E\u0432,
      \u043D\u043E \u0438\u043C\u0435\u0439\u0442\u0435 \u0432 \u0432\u0438\u0434\u0443,
