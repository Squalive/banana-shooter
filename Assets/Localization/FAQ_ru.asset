  m_TableData:
  - m_Id: 18583904256
    m_Localized: "\u041A\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u043E\u0432\u0442\u043E\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 6658750144512
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB~\xBB, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043A\u043E\u043D\u0441\u043E\u043B\u044C,
      \u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \xAB\u043E\u0442\u043B\u0430\u0434\u043E\u0447\u043D\u0430\u044F
      \u0437\u0430\u043F\u0438\u0441\u044C 1\xBB, \u0447\u0442\u043E\u0431\u044B
      \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043F\u043E\u0432\u0442\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 6681353248768
    m_Localized: "\u0417\u0430\u0442\u0435\u043C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435\u0441\u044C
      \u0432 \u0438\u0433\u0440\u0443 \u0438 \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
      \u043C\u0435\u043D\u044E, \u043D\u0430\u0436\u043C\u0438\u0442\u0435 <b>\u043D\u0430\u0447\u0430\u0442\u044C
      \u0437\u0430\u043F\u0438\u0441\u044C</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 7216886177792
    m_Localized: "\u0417\u0430\u0442\u0435\u043C \u043E\u043D \u043D\u0430\u0447\u043D\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C,
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u043C\u0435\u043D\u044E \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0430\u0436\u0430\u0442\u044C <b>\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0437\u0430\u043F\u0438\u0441\u044C</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 15122612346880
    m_Localized: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u041C\u0435\u043D\u044E
      -> \u041F\u043E\u0432\u0442\u043E\u0440, \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u044D\u0442\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  references:
    version: 2
