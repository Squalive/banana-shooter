    m_Localized: "G\u0142osowanie rozpocz\u0119te przez: {0}"
    m_Metadata:
      m_Items:
      - rid: 189510242361147394
  - m_Id: 72072202260832256
    m_Localized: "Wci\u015Bnij ESC by otworzy\u0107 menu i wybra\u0107 map\u0119
      lub tryb gry"
