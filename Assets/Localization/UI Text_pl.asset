      m_Items: []
  - m_Id: 71802435293667328
    m_Localized: "Tablica Zab\xF3jstw Poczekalni"
    m_Metadata:
      m_Items: []
  - m_Id: 72054896843546624
    m_Localized: "B\u0105d\u017A got\xF3w by zacz\u0105\u0107 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 72054985590824960
    m_Localized: "Zainfekowana osoba musi zainfekowa\u0107 ocala\u0142ych. Je\u017Celi
      nie ma ju\u017C ocala\u0142ych to zainfekowani wygraj\u0105. Je\u017Celi ocalali
      przetrwaj\u0105 ca\u0142\u0105 rund\u0119, wygraj\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 72055090586836992
    m_Localized: "Przytrzymaj prawy przycisk myszy by z\u0142apa\u0107 si\u0119 hakiem"
    m_Metadata:
      m_Items: []
  - m_Id: 72055200288858112
    m_Localized: "Po zab\xF3jstwie martwa osoba zostawi swoj\u0105 bananow\u0105
      dusz\u0119 zbierz j\u0105 by dosta\u0107 punkt, inaczej zab\xF3jstwo nie zostanie
      zaliczone."
    m_Metadata:
      m_Items: []
  - m_Id: 72055270237265920
    m_Localized: "Wci\u015Bnij F5 by spr\xF3bowa\u0107 jeszcze raz"
    m_Metadata:
      m_Items: []
  - m_Id: 72055427947290624
    m_Localized: "Wci\u015Bnij E by zaznaczy\u0107 swoj\u0105 gotowo\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 72055474613116928
    m_Localized: "Prawy przycisk by zobaczy\u0107 kursor"
    m_Metadata:
      m_Items: []
  - m_Id: 72055641022128128
    m_Localized: "Wyrzucanie: Wci\u015Bnij F1 by zag\u0142osowa\u0107 za, Wci\u015Bnij
      F2 by zag\u0142osowa\u0107 przeciw"
    m_Metadata:
      m_Items: []
  - m_Id: 72055757225320448
    m_Localized: "Jako zainfekowany jeste\u015B super szybki, mo\u017Cesz skaka\u0107
      kilka razy i masz mo\u017Cliwo\u015B\u0107 wcinania si\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 72058311053139968
    m_Localized: "Wci\u015Bnij E by u\u017Cy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 72059605692178432
    m_Localized: "Wyrzu\u0107 gracza: {0}"
    m_Metadata:
      m_Items:
