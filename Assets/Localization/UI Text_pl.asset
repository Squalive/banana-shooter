  - m_Id: 72191382066814976
    m_Localized: "U\u017Cywaj noktowizji"
    m_Metadata:
      m_Items: []
  - m_Id: 74219391565160448
    m_Localized: "Op\xF3\u017Anienie"
    m_Metadata:
      m_Items: []
  - m_Id: 74610085802795008
    m_Localized: "Mno\u017Cnik Ko\u0142ysania Broni"
    m_Metadata:
      m_Items: []
  - m_Id: 77217725805993984
    m_Localized: "Do\u0142\u0105cz na serwer Discord"
    m_Metadata:
      m_Items: []
  - m_Id: 77262095150194688
    m_Localized: Oficjalna strona internetowa
    m_Metadata:
      m_Items: []
  - m_Id: 79092237568811008
    m_Localized: "Podpowiedzi \u0141apania si\u0119 Hakiem"
    m_Metadata:
      m_Items: []
  - m_Id: 83104177924317184
    m_Localized: Dobra robota buntowniku, trzymaj tak dalej
    m_Metadata:
      m_Items: []
  - m_Id: 83104216520302592
    m_Localized: "\u015Awietnie walczy\u0142e\u015B, w\u0142a\u015Bnie takiej osoby
      potrzebowa\u0142em."
    m_Metadata:
      m_Items: []
  - m_Id: 83104404752277504
    m_Localized: "Nie smu\u0107 si\u0119, z\u0142o zawsze przegrywa"
    m_Metadata:
      m_Items: []
  - m_Id: 83104413484818432
    m_Localized: "Co ty robisz? Przecie\u017C twoj\u0105 robot\u0105 by\u0142a wygrana!
      Zostaniesz zwolniony!"
    m_Metadata:
      m_Items: []
  - m_Id: 83380486009233408
    m_Localized: "Bieganie Po \u015Acianach"
    m_Metadata:
      m_Items: []
  - m_Id: 83380605660143616
    m_Localized: "Szybkie R\u0105czki"
    m_Metadata:
      m_Items: []
  - m_Id: 83380695535689728
    m_Localized: "\u017Baba"
    m_Metadata:
      m_Items: []
  - m_Id: 83380726422544384
    m_Localized: Oznaczenie trafienia
    m_Metadata:
      m_Items: []
  - m_Id: 83380820853104640
    m_Localized: Nerd
    m_Metadata:
      m_Items: []
  - m_Id: 83380889027321856
    m_Localized: Gruby
    m_Metadata:
      m_Items: []
  - m_Id: 83380922325901312
    m_Localized: Bot
    m_Metadata:
      m_Items: []
  - m_Id: 83401314012733440
    m_Localized: Atuty
    m_Metadata:
      m_Items: []
  - m_Id: 83464252526403584
    m_Localized: "U\u017Cywane do biegania po \u015Bcianach"
    m_Metadata:
      m_Items: []
  - m_Id: 83464648506449920
    m_Localized: "Szybkie r\u0105czki pomagaj\u0105 ci szybciej prze\u0142adowywa\u0107
      o tyle szybciej \u017Ce o ho ho"
    m_Metadata:
      m_Items: []
  - m_Id: 83464695826587648
    m_Localized: "To pozwala skaka\u0107 ci BARDZO WYSOKO jak \u017Caba, kumasz?"
    m_Metadata:
      m_Items: []
  - m_Id: 83464729955639296
    m_Localized: "Je\u017Celi masz problemy z widokiem (kup sobie okulary) to ten
      atut pomo\u017Ce ci widzie\u0107 czy trafiasz"
    m_Metadata:
      m_Items: []
  - m_Id: 83464764109856768
    m_Localized: "Ten atut sprawia \u017Ce jeste\u015B wolniejszy ale zadajesz wi\u0119cej
      obra\u017Ce\u0144."
    m_Metadata:
      m_Items: []
  - m_Id: 83464802022170624
    m_Localized: "Ten atut sprawia \u017Ce jeste\u015B wolniejszy ale masz wi\u0119cej
      zdrowia."
    m_Metadata:
      m_Items: []
  - m_Id: 83464867809828864
    m_Localized: "Ten atut sprawia \u017Ce masz r\u0119ce jak z metalu czyli s\u0105
      bardziej stabilne i masz mniejszy odrzut broni"
    m_Metadata:
      m_Items: []
  - m_Id: 83817815756742656
    m_Localized: "Wy\u015Bcig zbroje\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 83861299565928448
    m_Localized: Ekspert liny z hakiem
    m_Metadata:
      m_Items: []
  - m_Id: 83863935652438016
    m_Localized: "Pozwala szybciej si\u0119 z\u0142apa\u0107 hakiem"
    m_Metadata:
      m_Items: []
  - m_Id: 83869235633692672
    m_Localized: Czas
    m_Metadata:
      m_Items: []
  - m_Id: 83871336032083968
    m_Localized: "Kr\xF3l Wzg\xF3rza"
    m_Metadata:
      m_Items: []
